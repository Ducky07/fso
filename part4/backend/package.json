{
  "name": "phonebook",
  "version": "1.0.0",
  "description": "Phonebook Nodejs Backend",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "dev": "NODE_ENV=development nodemon index.js",
    "build:ui": "rm -rf public && cd ../frontend && npm run build",
    "build": "npm install --omit=dev",
    "deploy": "npm run build:ui && npm run start",
    "test": "NODE_ENV=test node --test",
    "lint": "eslint ."
  },
  "author": "Jack Valley",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "mongodb": "^6.16.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.1.4"
  }
}
